<RCC>
    <qresource prefix="/icon">
        <file alias="icon">Resources/mainicon.ico</file>
    </qresource>
    <qresource prefix="/timeline_btn">
        <file alias="play_btn">Resources/play.png</file>
        <file alias="pause_btn">Resources/pause.png</file>
        <file alias="next_frame_btn">Resources/next_frame.png</file>
        <file alias="previous_frame_btn">Resources/previous_frame.png</file>
        <file alias="next_key_btn">Resources/next_key.png</file>
        <file alias="previous_key_btn">Resources/previous_key.png</file>
        <file alias="first_frame_btn">Resources/first_frame.png</file>
        <file alias="last_frame_btn">Resources/last_frame.png</file>
    </qresource>
    <qresource prefix="/viewport_tb">
        <file alias="translate">Resources/trans_icon.png</file>
        <file alias="rotate">Resources/rot_icon.png</file>
        <file alias="scale">Resources/scale_icon.png</file>
        <file alias="plane">Resources/plane_icon.png</file>
        <file alias="box">Resources/box_icon.png</file>
        <file alias="sphere">Resources/sphere_icon.png</file>
        <file alias="torus">Resources/torus_icon.png</file>
    </qresource>
    <qresource prefix="/layers_tb">
        <file alias="add_layer">Resources/add_layer.png</file>
        <file alias="add_to_layer">Resources/add_to_layer.png</file>
        <file alias="duplicate_layer">Resources/duplicate_layer.png</file>
        <file alias="move_layer_up">Resources/move_layer_up.png</file>
        <file alias="move_layer_down">Resources/move_layer_down.png</file>
        <file alias="remove_layer">Resources/remove_layer.png</file>
        <file alias="layer_icon">Resources/layer_icon.png</file>
        <file alias="layer_generic_node_icon">Resources/layer_generic_node_icon.png</file>
        <file alias="layer_viewitem_icon">Resources/layer_viewitem_icon.png</file>
        <file alias="layer_lock_icon">Resources/layer_lock_icon.png</file>
        <file alias="layer_link_icon">Resources/layer_link_icon.png</file>
        <file alias="layer_visibility_icon">Resources/layer_visibility_icon.png</file>
        <file alias="layer_nill_icon">Resources/layer_nill_icon.png</file>
        <file alias="layer_off_icon">Resources/layer_off_icon.png</file>
        <file alias="import_node_icon">Resources/import_node_icon.svg</file>
        <file alias="import_node_icon_png">Resources/import_node_icon.png</file>
        <file alias="home_level">Resources/home_level.png</file>
        <file alias="previous_level">Resources/previous_level.png</file>
    </qresource>
    <qresource prefix="/misc">
        <file alias="filepath">Resources/filepath_icon.png</file>
        <file alias="about_banner">Resources/about_banner.png</file>
        <file alias="stop_icon">Resources/generic_stop.png</file>
    </qresource>
    <qresource prefix="/python_tb">
        <file alias="execute">Resources/execute_python_icon.png</file>
        <file alias="install">Resources/install_python_icon.png</file>
        <file alias="save">Resources/save_script_icon.png</file>
        <file alias="save_as">Resources/save_script_as_icon.png</file>
        <file alias="load">Resources/load_script_icon.png</file>
    </qresource>
    <qresource prefix="/splash">
        <file alias="splash">Resources/splash.png</file>
    </qresource>
    <qresource prefix="/shelf_scripts">
        <file alias="new_rigid_obj">Resources/shelf_scripts/new_rigid_body.py</file>
        <file alias="dynamic_rigid_body">Resources/shelf_scripts/dynamic_rigid_body.py</file>
        <file alias="static_rigid_body">Resources/shelf_scripts/static_rigid_body.py</file>
        <file alias="glue_constraint">Resources/shelf_scripts/glue_constraint.py</file>
        <file alias="new_sph_body">Resources/shelf_scripts/new_sph_body.py</file>
        <file alias="new_sph_fluid">Resources/shelf_scripts/new_sph_fluid.py</file>
        <file alias="new_sph_emitter">Resources/shelf_scripts/new_sph_emitter.py</file>
        <file alias="add_sph_viscosity">Resources/shelf_scripts/add_sph_viscosity.py</file>
        <file alias="add_sph_vorticity">Resources/shelf_scripts/add_sph_vorticity.py</file>
        <file alias="add_sph_adhesion">Resources/shelf_scripts/add_sph_adhesion.py</file>
        <file alias="voronoi_fracture">Resources/shelf_scripts/voronoi_fracture.py</file>
        <file alias="slice_fracture">Resources/shelf_scripts/slice_fracture.py</file>
        <file alias="cutout_fracture">Resources/shelf_scripts/cutout_fracture.py</file>
    </qresource>
</RCC>
